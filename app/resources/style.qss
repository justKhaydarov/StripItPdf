/* StripItPdf — Qt stylesheet (vibrant-blue design system).
   primary #2563EB · accent #0EA5E9 · bg #F8FAFC · fg #0F172A
   muted #E2E8F0 / #64748B · card #FFFFFF · keep #16A34A · delete #EF4444     */

* {
    font-family: "Plus Jakarta Sans";
    color: #0F172A;
}
QMainWindow, QWidget#root { background: #F8FAFC; }

/* ---- side rails ---- */
QFrame#sidebar   { background: #FFFFFF; border-right: 1px solid #E2E8F0; }
QFrame#inspector { background: #FFFFFF; border-left: 1px solid #E2E8F0; }
QFrame#topbar    { background: #F8FAFC; border-bottom: 1px solid #E8EDF3; }

/* ---- brand ---- */
QLabel#brandTitle    { font-family: "Outfit"; font-size: 18px; font-weight: 700; color: #0F172A; }
QLabel#brandSubtitle { font-size: 11px; color: #64748B; }

/* ---- headings / text ---- */
QLabel#pageTitle    { font-family: "Outfit"; font-size: 21px; font-weight: 700; color: #0F172A; }
QLabel#pageSubtitle { font-size: 12px; color: #64748B; }
QLabel#sectionTitle { font-family: "Outfit"; font-size: 15px; font-weight: 600; color: #0F172A; }
QLabel#hint         { color: #64748B; font-size: 12px; }
QLabel.kicker       { color: #64748B; font-size: 11px; font-weight: 700; }

/* ---- primary CTA ---- */
QPushButton#primary {
    background: #2563EB; color: #FFFFFF; border: none;
    border-radius: 9px; padding: 10px 18px; font-size: 13px; font-weight: 700;
}
QPushButton#primary:hover  { background: #1D4ED8; }
QPushButton#primary:pressed{ background: #1E40AF; }
QPushButton#primary:disabled { background: #93B4F5; color: #EAF1FE; }

/* ---- ghost / outline button ---- */
QPushButton#ghost {
    background: transparent; color: #0F172A;
    border: 1px solid #E2E8F0; border-radius: 9px; padding: 9px 14px; font-weight: 600;
}
QPushButton#ghost:hover   { background: #F1F5F9; border-color: #CBD5E1; }
QPushButton#ghost:pressed { background: #E9EEF5; }

/* ---- round nav buttons ---- */
QPushButton#nav {
    background: #FFFFFF; color: #334155; border: 1px solid #E2E8F0;
    border-radius: 9px; min-width: 34px; min-height: 34px; font-size: 16px;
}
QPushButton#nav:hover    { background: #F1F5F9; border-color: #CBD5E1; }
QPushButton#nav:disabled { color: #CBD5E1; }

/* ---- segmented toggle (Original | Cleaned) ---- */
QPushButton#segLeft, QPushButton#segRight {
    background: #FFFFFF; color: #475569; border: 1px solid #E2E8F0;
    padding: 7px 16px; font-weight: 600; font-size: 12px;
}
QPushButton#segLeft  { border-top-left-radius: 9px; border-bottom-left-radius: 9px; border-right: none; }
QPushButton#segRight { border-top-right-radius: 9px; border-bottom-right-radius: 9px; }
QPushButton#segLeft:checked, QPushButton#segRight:checked {
    background: #2563EB; color: #FFFFFF; border-color: #2563EB;
}

/* ---- page list ---- */
QListWidget#pages { background: transparent; border: none; outline: 0; }
QListWidget#pages::item {
    border-radius: 10px; padding: 6px; margin: 3px 2px; color: #475569;
}
QListWidget#pages::item:hover    { background: #F1F5F9; }
QListWidget#pages::item:selected { background: #EAF1FE; color: #2563EB; }

/* ---- element list surfaces (keep them on the inspector's white) ---- */
QScrollArea#elemScroll { background: transparent; border: none; }
QScrollArea#elemScroll > QWidget > QWidget { background: transparent; }
QWidget#elemHost { background: transparent; }

/* ---- element rows ---- */
QFrame#elcard {
    background: #FFFFFF; border: 1px solid #E7ECF3; border-radius: 12px;
}
QFrame#elcard:hover { border-color: #C7D2E0; }
QFrame#elcard[state="keep"] { border-color: #B7E4C7; background: #F2FBF6; }
QFrame#elcard[state="keep"]:hover { border-color: #86D6A6; }
QFrame#elcard[state="drop"] { background: #FFFFFF; }
QLabel#elLabel { font-size: 13px; font-weight: 600; color: #0F172A; }
QLabel#elMeta  { font-size: 11px; color: #64748B; }
QLabel#badgeKeep { color: #16A34A; font-size: 11px; font-weight: 800; }
QLabel#badgeDrop { color: #CBD5E1; font-size: 11px; font-weight: 800; }

/* ---- checkbox ---- */
QCheckBox { spacing: 8px; color: #334155; font-size: 13px; }
QCheckBox::indicator { width: 20px; height: 20px; }
QCheckBox::indicator:checked   { image: url(:/icons/check_on.png); }
QCheckBox::indicator:unchecked { image: url(:/icons/check_off.png); }

/* ---- status / footer ---- */
QLabel#status { color: #64748B; font-size: 12px; }
QLabel#footer { color: #94A3B8; font-size: 11px; }

/* ---- scrollbars (thin) ---- */
QScrollBar:vertical   { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #94A3B8; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: #CBD5E1; border-radius: 4px; min-width: 30px; }

QToolTip { background: #0F172A; color: #F8FAFC; border: none; padding: 6px 8px; border-radius: 6px; }
